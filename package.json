    "ship": "npm run lint && npm run type-check && npm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@prisma/client": "^5.12.0",
    "zod": "^3.23.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@playwright/test": "^1.43.0",
    "typescript": "^5.4.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.38",
    "autoprefixer": "^10.4.19",
    "prisma": "^5.12.0",
    "tsx": "^4.19.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "@types/react-dom": "^18.2.0",
    "dotenv": "^16.4.5"
  }

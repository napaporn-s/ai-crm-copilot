NODE_ENV=development
# 3021 is deliberately non-default — this machine already runs other local
# projects on 3000/3001/3002. Override freely if it collides on yours.
PORT=3021

# Database (Prisma / PostgreSQL)
# Local/dev: points at the Docker Postgres container (docker-compose.yml) — a single instance, no
# pooling needed.
DATABASE_URL="postgresql://user:password@localhost:5432/jenosize?schema=public"

# DIRECT_URL: Prisma Migrate/CLI always needs a direct (non-pooled) connection — the schema engine
# doesn't work through a PgBouncer transaction-mode pooler. Locally this is the same DB as
# DATABASE_URL above; in production it must point at Neon's non-pooler endpoint (see below).
DIRECT_URL="postgresql://user:password@localhost:5432/jenosize?schema=public"

# Production (Vercel + Neon — see README.md §6): each API route runs as its own serverless function,
# so many short-lived concurrent invocations can each spin up a new Prisma Client / Postgres
# connection — without pooling this can exceed Neon's max_connections. Point DATABASE_URL at Neon's
# pooled endpoint ("-pooler" in the hostname) with pgbouncer=true, and DIRECT_URL at Neon's direct
# (non-pooled) endpoint, per Prisma's documented Neon pattern:
#   DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/jenosize?sslmode=require&pgbouncer=true"
#   DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/jenosize?sslmode=require"

# Session signing (HS256 JWT via jose) — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-value"

# LINE Official Account (test channel only — never a real/production channel)
# Set LINE_MOCK_MODE=true to use the in-memory MockLineAdapter (no real LINE calls, used in tests/local dev)
LINE_MOCK_MODE=true
LINE_CHANNEL_SECRET="replace-with-line-channel-secret"
LINE_CHANNEL_ACCESS_TOKEN="replace-with-line-channel-access-token"

# Enables test-only request hooks (x-simulate-ai-failure). Used by the E2E
# suite (see e2e/ai-copilot-fallback.spec.ts). MUST be unset/false in any
# real deployment — it lets a caller force the AI fallback path on demand.
ALLOW_TEST_HOOKS=false

# AI Copilot provider — set AI_MOCK_MODE=true to force the heuristic fallback engine
# (no external LLM calls), useful for CI and for demoing the fallback path deterministically.
AI_MOCK_MODE=true
AI_PROVIDER_API_KEY="replace-with-provider-api-key"
AI_PROVIDER_BASE_URL="https://api.openai.com/v1"
AI_REQUEST_TIMEOUT_MS=8000
